# Linked Ministries: the names of the settings and what each is. NO values here. Real values live only in Railway's Variables
# (see DEPLOY.md) or in your own shell, never in this repository. The boot guard (server/config.mjs) says in words what is wrong.

# the database (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# production | test  (test is for a development machine only)
LEXOS_ENV=production
# the content-security policy: enforce (production refuses anything else)
LEXOS_CSP=enforce
# the database connection: require (encrypted) with a named person's attestation, or verify-full with LEXOS_DB_CA_PEM / LEXOS_DB_CA_FILE
LEXOS_DB_TLS=require
# attested:<who>:<YYYY-MM-DD> : a named person accepts that the database's identity is not checked
LEXOS_DB_TLS_UNVERIFIED=
# 64 hex characters (openssl rand -hex 32)
LEXOS_INTERNAL_KEY=
# 16 or more characters (openssl rand -hex 32). Opens /api/health/detail for the operator and nothing else. Optional.
KPI_READ_TOKEN=
# how sign-in codes and answers are emailed: smtps://<user>:<app password>@smtp.gmail.com:465 (the @ in the user is %40)
LEXOS_SMTP_URL=
# the address they come from, for example: Linked Ministries <board@linkedm.org>
LEXOS_MAIL_FROM=
# this site's own address, https://...
LEXOS_PUBLIC_URL=https://linkedm.org
# set by the host; the Dockerfile says 8080
PORT=8080

# NEVER set this in production (the server refuses to start): LEXOS_DEV_CODES (prints sign-in codes; a development machine only).
